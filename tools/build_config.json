{
  "toolchain": {
    "sdcc": ".toolchain/sdcc/bin/sdcc",
    "include_dirs": [
      ".toolchain/sdcc/include",
      ".toolchain/sdcc/include/mcs51"
    ],
    "lib_dir": ".toolchain/sdcc/share/sdcc/lib/mcs251-large-stack-auto",
    "libraries": [
      "mcs251.lib",
      "libsdcc.lib",
      "liblong.lib",
      "libint.lib",
      "libfloat.lib",
      "liblonglong.lib"
    ]
  },
  "cflags": [
    "-mmcs251",
    "--model-large",
    "--stack-auto",
    "--opt-code-size",
    "--constseg",
    "CSEG"
  ],
  "ldflags": [
    "-mmcs251",
    "--model-large",
    "--stack-auto",
    "--constseg",
    "CSEG",
    "--nostdlib",
    "--iram-size",
    "0x1000",
    "--xram-loc",
    "0x010000",
    "--xram-size",
    "0x2000",
    "--code-loc",
    "0xff0000",
    "-Wl-m"
  ],
  "include_dirs": [
    "libs/stc32g/include",
    "libs/stc32g/startup",
    "libs/stc32g/hal/inc",
    "libs/freertos-port",
    "third_party/FreeRTOS-Kernel/include"
  ],
  "library_sources": [
    "libs/stc32g/startup/startup.c",
    "libs/stc32g/hal/src/stc32g_gpio.c",
    "libs/stc32g/hal/src/stc32g_uart.c",
    "libs/stc32g/hal/src/stc32g_timer.c"
  ],
  "kernel_sources": [
    "third_party/FreeRTOS-Kernel/tasks.c",
    "third_party/FreeRTOS-Kernel/queue.c",
    "third_party/FreeRTOS-Kernel/list.c",
    "third_party/FreeRTOS-Kernel/portable/MemMang/heap_1.c"
  ],
  "freertos_sources": [
    "libs/freertos-port/port.c"
  ],
  "apps": {
    "hello_uart": {
      "sources": ["apps/hello_uart/main.c"],
      "free_rtos": false
    },
    "mpu6050_uart": {
      "sources": [
        "apps/mpu6050_uart/main.c",
        "libs/stc32g/hal/src/stc32g_i2c.c"
      ],
      "free_rtos": false
    },
    "mpu6050_dual_vofa": {
      "sources": [
        "apps/mpu6050_uart/main.c",
        "libs/stc32g/hal/src/stc32g_i2c.c"
      ],
      "free_rtos": false
    },
    "vehicle": {
      "sources": [
        "apps/vehicle/main.c",
        "apps/vehicle/remote.c",
        "apps/vehicle/expansion.c",
        "apps/vehicle/imu.c",
        "apps/vehicle/chassis.c",
        "apps/vehicle/gimbal.c",
        "libs/stc32g/hal/src/stc32g_i2c.c"
      ],
      "free_rtos": false
    },
    "vehicle_debug": {
      "sources": [
        "apps/vehicle/main.c",
        "apps/vehicle/remote.c",
        "apps/vehicle/expansion.c",
        "apps/vehicle/imu.c",
        "apps/vehicle/chassis.c",
        "apps/vehicle/gimbal.c",
        "libs/stc32g/hal/src/stc32g_i2c.c"
      ],
      "free_rtos": false
    },
    "vehicle_tune": {
      "sources": [
        "apps/vehicle/tune_main.c",
        "apps/vehicle/expansion.c",
        "apps/vehicle/imu.c",
        "apps/vehicle/gimbal.c",
        "libs/stc32g/hal/src/stc32g_i2c.c",
        "libs/stc32g/hal/src/stc32g_uart2.c"
      ],
      "free_rtos": false
    },
    "vehicle_tune_hid": {
      "sources": [
        "apps/vehicle/tune_hid_main.c",
        "apps/vehicle/expansion.c",
        "apps/vehicle/imu.c",
        "apps/vehicle/gimbal.c",
        "libs/stc32g/hal/src/stc32g_i2c.c",
        "libs/stc32g/hal/src/stc32g_usb_hid.c"
      ],
      "free_rtos": false
    },
    "freertos_coop": {
      "sources": ["apps/freertos_coop/main.c"],
      "free_rtos": true
    },
    "timer_irq": {
      "sources": ["apps/timer_irq/main.c"],
      "free_rtos": false
    },
    "dpXL_test": {
      "sources": ["apps/dpXL_test/main.c"],
      "free_rtos": false
    },
    "freertos_blinky": {
      "sources": ["apps/freertos_blinky/main.c"],
      "free_rtos": true
    },
    "usb_hid_isp": {
      "sources": [
        "apps/usb_hid_isp/main.c",
        "libs/stc32g/hal/src/stc32g_usb_hid.c",
        "libs/stc32g/hal/src/stc32g_iap.c"
      ],
      "free_rtos": false
    },
    "bootloader": {
      "sources": [
        "apps/bootloader/main.c",
        "libs/stc32g/hal/src/stc32g_usb_hid.c",
        "libs/stc32g/hal/src/stc32g_iap.c"
      ],
      "free_rtos": false,
      "code_start": "0xFE0000",
      "code_end": "0xFE3DFF"
    },
    "iap_selftest": {
      "sources": [
        "apps/iap_selftest/main.c",
        "libs/stc32g/hal/src/stc32g_usb_hid.c",
        "libs/stc32g/hal/src/stc32g_iap.c"
      ],
      "free_rtos": false,
      "code_start": "0xFE4000",
      "code_end": "0xFEFFFF"
    }
  },
  "per_app_cflags": {
    "mpu6050_dual_vofa": [
      "-DMPU6050_COUNT=2",
      "-DMPU6050_UART_GROUP=3"
    ],
    "vehicle_debug": ["-DVEHICLE_DEBUG=1"],
    "freertos_coop": ["-DconfigUSE_PREEMPTION=0"],
    "bootloader": [
      "-DSTC32G_USB_HID_PID=0xFF02",
      "-DSTC32G_USB_HID_PRODUCT=\"stcnav bootloader\""
    ],
    "iap_selftest": [
      "-DSTC32G_USB_HID_PID=0xFF03",
      "-DSTC32G_USB_HID_PRODUCT=\"stcnav iap test\""
    ]
  },
  "per_app_ldflags": {
    "bootloader": ["-Wl-b GSINIT0=0xfe0000"]
  },
  "per_file_cflags": {
    "port.c": ["--opt-code-speed"],
    "stc32g_timer.c": ["--opt-code-speed"]
  }
}
